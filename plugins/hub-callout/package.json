{
  "name": "dsh-hub-callout",
  "version": "0.1.5",
  "description": "把消息里的 GitHub admonition 语法（> [!NOTE] / > [!BOOK] 等）渲染成带彩色标题的提示块。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genesi599/dsh-plugins.git",
    "directory": "plugins/hub-callout"
  },
  "homepage": "https://github.com/Genesi599/dsh-plugins/tree/main/plugins/hub-callout",
  "bugs": {
    "url": "https://github.com/Genesi599/dsh-plugins/tree/main/plugins/hub-callout/issues"
  }
}