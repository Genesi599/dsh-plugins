{
  "name": "dsh-hub-desktop-ui",
  "version": "0.2.25",
  "description": "Compact DSH front-end: sidebar status card, project and task-line integration, in-session group chat room, and a guided new-project dialog. Follows the DSH theme as-is.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/session-events.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "dsh-hub-core": "^0.1.0"
  },
  "dependencies": {
    "dsh-sync-bridge": "^0.1.0",
    "dsh-desktop-watchdog": "^0.2.0",
    "dsh-clone-handoff": "^0.1.0",
    "dsh-agent-tasks": "^0.1.0",
    "dsh-queue-triage": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genesi599/dsh-plugins.git",
    "directory": "plugins/hub-desktop-ui"
  },
  "homepage": "https://github.com/Genesi599/dsh-plugins/tree/main/plugins/hub-desktop-ui",
  "bugs": {
    "url": "https://github.com/Genesi599/dsh-plugins/tree/main/plugins/hub-desktop-ui/issues"
  }
}