{
  "name": "dsh-hub-desktop-ui",
  "version": "0.2.3",
  "description": "AI-Agent-Hub 的 DSH 前端形态插件：暖色暗调、紧凑侧栏、品牌标记与侧栏状态卡。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/session-events.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "dsh-hub-core": "^0.1.0"
  },
  "dependencies": {
    "dsh-sync-bridge": "^0.1.0",
    "dsh-desktop-watchdog": "^0.2.0",
    "dsh-clone-handoff": "^0.1.0",
    "dsh-agent-tasks": "^0.1.0",
    "dsh-queue-triage": "^0.1.0"
  }
}
